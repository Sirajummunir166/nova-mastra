# Vercel AI Gateway — required locally (on Vercel, OIDC covers it)
AI_GATEWAY_API_KEY=

# dakio-api backend
DAKIO_API_URL=http://localhost:5001
# Must equal dakio-api's NOVA_SERVICE_SECRET (self-mints per-tenant service tokens)
NOVA_SERVICE_SECRET=
# Optional pre-minted per-tenant tokens: {"storeId":"jwt", ...}
# NOVA_SERVICE_TOKENS=

# Local dev only — default tenant when /chat gets no storeId
NOVA_DEV_STORE_ID=

PORT=2100
NOVA_MODEL=anthropic/claude-sonnet-5
