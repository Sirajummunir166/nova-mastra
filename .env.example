# Vercel AI Gateway — required locally (on Vercel, OIDC covers it)
AI_GATEWAY_API_KEY=

# dakio-api backend — FULL url including scheme
# (prod: https://dakio-api-production.up.railway.app)
DAKIO_API_URL=http://localhost:5001

# Shared secret guarding /api/* (Mastra Studio) and /chat on any deployed
# instance. Unset = open; only safe on loopback.
# NOVA_STUDIO_TOKEN=
# Must equal dakio-api's NOVA_SERVICE_SECRET (self-mints per-tenant service tokens)
NOVA_SERVICE_SECRET=
# Must equal dakio-api's NOVA_INBOX_SHARED_SECRET — authenticates inbox pushes
# to POST /customer/message. Unset = the ingress fails closed with 503.
NOVA_INBOX_SHARED_SECRET=
# Optional pre-minted per-tenant tokens: {"storeId":"jwt", ...}
# NOVA_SERVICE_TOKENS=
# Legacy single-store token. It is bound to ONE store and refused for every
# other — an unbound one would hand every tenant's client the same tenant's
# credential. The binding comes from this variable, else from the token's own
# tenantId claim; an opaque, undeclared token is used for nobody.
# NOVA_SERVICE_TOKEN=
# NOVA_SERVICE_TOKEN_STORE_ID=

# Local dev only — default tenant when /chat gets no storeId
NOVA_DEV_STORE_ID=

PORT=2100
NOVA_MODEL=anthropic/claude-sonnet-5

# Optional Postgres URL for chat-session persistence (survives restarts).
# Unset = sessions are in-memory only and a restart loses them.
# NOVA_PG_URL=postgresql://postgres:postgres@127.0.0.1:5432/nova_mastra

# Which StoreClient backend storeFor() builds: `dakio` (the default, including
# when unset) talks to the live API; `demo` is the deterministic in-process
# store the eval suites opt into. Read in exactly one place — src/store/mode.ts.
# NOVA_STORE_BACKEND=dakio

# Bounds on every dakio-api request: per attempt, and for the whole call
# including retries and backoff. Both are far inside a brain job's 10-minute
# lease, so a hung backend surfaces as an error instead of parking a job.
# NOVA_STORE_TIMEOUT_MS=20000
# NOVA_STORE_DEADLINE_MS=45000

# The brain's dispatcher tick. `off` stops it claiming; job turns default to
# shadow (draft, write nothing) until NOVA_BRAIN_TURN_MODE=live opts in.
# NOVA_BRAIN_DISPATCH=on
# NOVA_BRAIN_TURN_MODE=shadow
