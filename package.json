{
  "name": "nova-mastra",
  "version": "0.1.0",
  "private": true,
  "description": "Nova chat service on Mastra + Express — token-lean replacement for the eve chat lane",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "studio": "mastra dev",
    "studio:prod": "mastra studio --server-host nova-mastra-production.up.railway.app --server-protocol https --server-port 443 --server-api-prefix /api",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.49",
    "@mastra/core": "^1.57.0",
    "@mastra/express": "^1.4.14",
    "@mastra/observability": "^1.16.5",
    "@mastra/pg": "^1.20.0",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "mastra": "^1.24.0",
    "pg": "^8.23.0",
    "tsx": "^4.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.0"
  }
}
